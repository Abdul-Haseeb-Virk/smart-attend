{
  "compilerOptions": {
    "target": "ES2022",
    // "module": "CommonJS",
    "module": "ES2022",
    "moduleResolution": "Bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    // "types": ["node"],
    "lib": ["ES2022"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}